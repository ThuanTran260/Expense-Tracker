# Docker Compose — copy thành `.env` ở ROOT rồi điền giá trị thật
# File này KHÔNG bao giờ được commit (`.env` thật đã gitignore).
# Lưu ý: file này chỉ dành cho docker-compose.yml — backend chạy local đọc backend/.env.

# Bắt buộc ≥32 ký tự ngẫu nhiên. Tạo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Compose sẽ TỪ CHỐI start nếu thiếu 1 trong 2 biến dưới.
JWT_ACCESS_SECRET=your-access-token-secret-min-32-chars-here
JWT_REFRESH_SECRET=your-refresh-token-secret-min-32-chars-here

# PostgreSQL nội bộ của stack Docker (chỉ dùng trong network nội bộ)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=expense_tracker

# Domain frontend cho CORS khi deploy (mặc định http://localhost:80)
FRONTEND_URL=http://localhost
