NODE_ENV=development
PORT=5000

# Database — thay bằng connection string PostgreSQL của bạn
# Supabase:   postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres
# Local:      postgresql://postgres:password@localhost:5432/expense_tracker?schema=public
DATABASE_URL=postgresql://user:password@localhost:5432/expense_tracker

# JWT Secrets — tạo chuỗi ngẫu nhiên dài ít nhất 32 ký tự
# Gợi ý tạo nhanh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=your-access-token-secret-min-32-chars-here
JWT_REFRESH_SECRET=your-refresh-token-secret-min-32-chars-here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS — danh sách origins được phép, cách nhau bởi dấu phẩy
CORS_ORIGINS=http://localhost:5173,http://localhost

# Rate Limiting (auth routes)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=5
