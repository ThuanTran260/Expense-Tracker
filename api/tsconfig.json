{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "paths": {
      "@/*": ["../backend/src/*"]
    }
  },
  "include": ["./index.ts", "../backend/src/**/*.ts"]
}
