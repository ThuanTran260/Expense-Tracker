#!/bin/sh
# ──────────────────────────────────────────────────────────────
# Pre-commit hook: Chặn commit nếu phát hiện secrets
# ──────────────────────────────────────────────────────────────

echo "🔐 Scanning for secrets before commit..."

# Danh sách các pattern nguy hiểm cần chặn
PATTERNS=(
  "password\s*=\s*['\"][^'\"]{3,}"
  "DATABASE_URL\s*=\s*['\"]postgresql://[^@]+:[^@]+@"
  "JWT.*SECRET\s*=\s*['\"][A-Za-z0-9+/]{20,}"
  "supabase\.co"
  "mongodb\+srv://"
  "sk-[a-zA-Z0-9]{20,}"
  "AIza[0-9A-Za-z\-_]{35}"
  "AKIA[0-9A-Z]{16}"
)

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

SECRET_FOUND=0

for FILE in $STAGED_FILES; do
  # Bỏ qua file .env.example và file nhị phân
  if echo "$FILE" | grep -qE "\.example$|\.md$|node_modules"; then
    continue
  fi
  
  for PATTERN in "${PATTERNS[@]}"; do
    if git diff --cached "$FILE" 2>/dev/null | grep -qiE "$PATTERN"; then
      echo ""
      echo "🚨 SECURITY ALERT: Phát hiện thông tin nhạy cảm (secret) trong file: $FILE"
      echo "   Pattern: $PATTERN"
      echo ""
      echo "   ➤ Hãy xóa giá trị thật và chuyển sang đọc qua process.env"
      echo "   ➤ Không commit file .env chứa mật khẩu thật"
      echo ""
      SECRET_FOUND=1
    fi
  done
done

# Kiểm tra có commit file .env thật không
for FILE in $STAGED_FILES; do
  BASENAME=$(basename "$FILE")
  if [ "$BASENAME" = ".env" ]; then
    echo ""
    echo "🚨 SECURITY ALERT: Bạn đang cố commit file '$FILE' (có thể chứa secrets)!"
    echo "   ➤ File .env phải có trong .gitignore và không bao giờ được commit lên Git."
    echo ""
    SECRET_FOUND=1
  fi
done

if [ "$SECRET_FOUND" -eq 1 ]; then
  echo "❌ Commit bị chặn! Hãy kiểm tra và sửa các vấn đề trên trước khi commit lại."
  exit 1
fi

echo "✅ Không phát hiện secrets. Commit được phép!"
exit 0
